# ByteBeacon 2.0 Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT ONLY. NEVER COMMIT SECRETS TO GIT.

# Environment Mode: development | test | staging | production
NODE_ENV=development

# Server Port
PORT=3000

# PostgreSQL Connection String (Placeholder only)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bytebeacon_dev

# Redis Connection String (Placeholder only)
REDIS_URL=redis://localhost:6379

# Allowed CORS Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Provider Mock Control (Set to false in production)
ALLOW_MOCK_PROVIDERS=true

# Logging Level: debug | info | warn | error
LOG_LEVEL=info
