{
  "name": "bytebeacon",
  "displayName": "ByteBeacon (ByteBeacon 2.0)",
  "private": true,
  "version": "2.0.0-dev",
  "type": "module",
  "description": "ByteBeacon 2.0 Monorepo Foundation — Production Brand: ByteBeacon",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"./**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "migrate": "pnpm --filter @bytebeacon/backend migrate",
    "verify": "tsx scripts/verify-foundation.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
