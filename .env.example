# --- FRONTEND (Vite) ---
VITE_API_URL=/api
VITE_APP_NAME=ByteBeacon
VITE_ADMIN_SECRET_CODE=your_secret_code
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# --- AUTHENTICATION ---
JWT_SECRET=your_jwt_secret
ALLOWED_ADMIN_EMAILS=admin@example.com

# --- BACKEND (Node.js) ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com
ADMIN_EMAIL=admin@example.com

# --- DATABASE (Supabase) ---
# If using the Pooler (Recommended for Vercel)
DATABASE_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres

# OR Individual variables (The backend will build the URL)
SUPABASE_PROJECT_ID=your_id
DB_PASSWORD=your_password

# --- SUPABASE SDK (Backend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# --- PAYMENTS & APIS ---
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_SECRET_KEY=sk_live_...
DATAHOUSE_API_KEY=ak_live_...
DATAHOUSE_WEBHOOK_SECRET=whsec_...
VITE_GOOGLE_CLIENT_ID=your_id.apps.googleusercontent.com

# --- EMAIL ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=app_password
